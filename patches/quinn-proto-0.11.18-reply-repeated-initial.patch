+    /// A client repeats its Initial when it has heard nothing back, so the server's flight in
+    /// flight is likely lost: probe it now, once a connection (RFC 9002 §6.2.3), not at the PTO.
+    fn reply_to_repeated_initial(&mut self) {
+        if !self.config.reply_repeated_initial
+            || self.replied_repeated_initial
+            || !self.side.is_server()
+            || !self.is_handshaking()
+            || ![SpaceId::Initial, SpaceId::Handshake].iter().any(|&s| self.spaces[s].has_in_flight())
+        {
+            return;
+        }
+        self.replied_repeated_initial = true;
+        for space in [SpaceId::Initial, SpaceId::Handshake, SpaceId::Data] {
+            if self.spaces[space].has_in_flight() {
+                self.spaces[space].loss_probes = self.spaces[space].loss_probes.saturating_add(1);
+            }
+        }
+    }
