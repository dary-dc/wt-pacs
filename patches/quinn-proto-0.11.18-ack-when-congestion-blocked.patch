+
+const ACK_TEST_LATENCY: Duration = Duration::from_millis(100);
+
+/// Time from a client PING to the client receiving the server's ACK of it, with the server
+/// either idle or congestion-blocked with stream data still queued.
+fn ack_of_ping_after(server_blocked: bool) -> Duration {
+    let _guard = subscribe();
+    // Two packets of window: full at once and for the whole round trip, pacing or not.
+    let mut cubic = congestion::CubicConfig::default();
+    cubic.initial_window(2 * 1452);
+    let mut transport = TransportConfig::default();
+    transport.deterministic_packet_numbers(true);
+    transport.congestion_controller_factory(Arc::new(cubic));
+    let mut server = server_config();
+    server.transport = Arc::new(transport);
+    let mut pair = Pair::new(Default::default(), server);
+    pair.latency = ACK_TEST_LATENCY;
+    let (client_ch, server_ch) = pair.connect_with(client_config_with_deterministic_pns());
+    pair.drive();
+
+    if server_blocked {
+        let s = pair.server_streams(server_ch).open(Dir::Uni).unwrap();
+        pair.server_send(server_ch, s).write(&[0; 200_000]).unwrap();
+        pair.drive_server();
+        let conn = pair.server_conn_mut(server_ch);
+        assert!(
+            conn.bytes_in_flight() + 1500 > conn.congestion_window(),
+            "the server's window did not fill: {} of {}",
+            conn.bytes_in_flight(),
+            conn.congestion_window()
+        );
+    }
+
+    let acks = pair.client_conn_mut(client_ch).stats().frame_rx.acks;
+    let start = pair.time;
+    pair.client_conn_mut(client_ch).ping();
+    pair.drive_client();
+    // A millisecond clock rather than `step()`, which stops once no timer is armed although a
+    // packet is still on the simulated wire.
+    while pair.client_conn_mut(client_ch).stats().frame_rx.acks == acks {
+        assert!(pair.time - start < Duration::from_secs(1), "the PING was never acknowledged");
+        pair.time += Duration::from_millis(1);
+        pair.drive_client();
+        pair.drive_server();
+    }
+    pair.time - start
+}
+
+/// RFC 9000 §13.2.1: an ack-eliciting packet is acknowledged within `max_ack_delay`, and RFC 9002
+/// §7: an ACK-only packet is not congestion controlled. A server whose window is full, with more
+/// stream data queued, still owes the client its ACK on time — one latency out, `max_ack_delay`,
+/// one latency back — not when the window reopens a round trip after it filled.
+#[test]
+fn ack_is_not_held_back_by_a_full_congestion_window() {
+    let max_ack_delay = Duration::from_millis(TransportParameters::default().max_ack_delay.into_inner());
+    let on_time = 2 * ACK_TEST_LATENCY + max_ack_delay;
+    assert_eq!(ack_of_ping_after(false), on_time, "the idle control");
+    let blocked = ack_of_ping_after(true);
+    assert!(blocked <= on_time, "the ACK came {blocked:?} after the PING, not within {on_time:?}");
+}
