< RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
---
> RUN --mount=type=secret,id=build_ca,target=/ca.crt,mode=0444 sed -i "s|http://|https://|" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::https::CAInfo=/ca.crt update && apt-get -o Acquire::https::CAInfo=/ca.crt install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
