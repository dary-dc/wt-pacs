+// Three 8-bit lines clamped and interleaved 16 pixels a step; the tail goes through pack.
+uint32_t interleave3(const ojph::si32* r, const ojph::si32* g, const ojph::si32* b, uint8_t* dst, uint32_t w) {
+  auto narrow = [](const ojph::si32* p) {
+    const v128_t lo = wasm_i16x8_narrow_i32x4(wasm_v128_load(p), wasm_v128_load(p + 4));
+    const v128_t hi = wasm_i16x8_narrow_i32x4(wasm_v128_load(p + 8), wasm_v128_load(p + 12));
+    return wasm_u8x16_narrow_i16x8(lo, hi);
+  };
+  uint32_t x = 0;
+  for (; x + 16 <= w; x += 16, dst += 48) {
+    const v128_t R = narrow(r + x), G = narrow(g + x), B = narrow(b + x);
+    const v128_t t0 = wasm_i8x16_shuffle(R, G, 0, 16, 1, 17, 2, 18, 3, 19, 4, 20, 5, 21, 6, 22, 7, 23);
+    const v128_t t1 = wasm_i8x16_shuffle(R, G, 8, 24, 9, 25, 10, 26, 11, 27, 12, 28, 13, 29, 14, 30, 15, 31);
+    const v128_t u = wasm_i8x16_shuffle(t0, t1, 11, 0, 12, 13, 0, 14, 15, 0, 16, 17, 0, 18, 19, 0, 20, 21);
+    wasm_v128_store(dst, wasm_i8x16_shuffle(t0, B, 0, 1, 16, 2, 3, 17, 4, 5, 18, 6, 7, 19, 8, 9, 20, 10));
+    wasm_v128_store(dst + 16, wasm_i8x16_shuffle(u, B, 0, 21, 2, 3, 22, 5, 6, 23, 8, 9, 24, 11, 12, 25, 14, 15));
+    wasm_v128_store(dst + 32, wasm_i8x16_shuffle(t1, B, 26, 6, 7, 27, 8, 9, 28, 10, 11, 29, 12, 13, 30, 14, 15, 31));
+  }
+  return x;
+}
