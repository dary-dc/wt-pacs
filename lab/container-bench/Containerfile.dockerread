# Row 195's images, from the repository root: `rig` is the deploy's server image with the benches added, `data`
# the toolchain that makes the cells' coded frames. README.md §In a container (row 195).
ARG REGISTRY=docker.io/library
ARG RUST=${REGISTRY}/rust:1.97-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97

FROM ${RUST} AS benches
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY common ./common
COPY server ./server
COPY client/transport/wasm/Cargo.toml ./client/transport/wasm/Cargo.toml
COPY client/transport/wasm/src ./client/transport/wasm/src
COPY tools ./tools
COPY ingest/from-parser ./ingest/from-parser
COPY lab/container-bench ./lab/container-bench
COPY lab/disk-access-bench ./lab/disk-access-bench
COPY lab/window-harness ./lab/window-harness
COPY lab/telemetry-bench ./lab/telemetry-bench
COPY patched ./patched
COPY patches ./patches
COPY scripts/patch_crate.sh ./scripts/
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target \
    cargo build --release --locked --bin container_bench --bin writer_bench --bin pack-series --bin check-fastpath \
      --bin server_ab && \
    cd target/release && cp container_bench writer_bench pack-series check-fastpath server_ab /usr/local/bin/

FROM wt-pacs-server AS rig
USER root
RUN install -d -o 10001 -g 10001 /srv/series /srv/coded
COPY --from=benches /usr/local/bin/container_bench /usr/local/bin/writer_bench /usr/local/bin/pack-series \
     /usr/local/bin/check-fastpath /usr/local/bin/server_ab /usr/local/bin/
USER 10001

FROM ${RUST} AS data
RUN rm -f /etc/apt/sources.list.d/* \
 && echo "deb http://snapshot.debian.org/archive/debian/20261001T000000Z bookworm main" > /etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends cmake=3.25.1-1 ninja-build=1.11.1-2~deb12u1 meson=1.0.1-5 \
    nasm=2.16.01-1 python3-venv=3.11.2-1+b1 \
 && rm -rf /var/lib/apt/lists/*
