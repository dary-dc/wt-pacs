+    };
+
+    //////////////////////////////////////////////////////////////////////////
+    size subband::cb_size_at(ui32 row, ui32 col) const
+    {
+      ui32 tbx0 = band_rect.org.x, tby0 = band_rect.org.y;
+      ui32 tbx1 = tbx0 + band_rect.siz.w, tby1 = tby0 + band_rect.siz.h;
+      ui32 xlb = (tbx0 >> xcb_prime) << xcb_prime;
+      ui32 ylb = (tby0 >> ycb_prime) << ycb_prime;
+      size s;
+      s.w = ojph_min(tbx1, xlb + ((col + 1) << xcb_prime))
+          - ojph_max(tbx0, xlb + (col << xcb_prime));
+      s.h = ojph_min(tby1, ylb + ((row + 1) << ycb_prime))
+          - ojph_max(tby0, ylb + (row << ycb_prime));
+      return s;
+    }
+
+    //////////////////////////////////////////////////////////////////////////
+    void subband::decode_unit(subband* const* bands, ui32 n)
+    {
+      size_t count = 0, bytes = 0;
+      for (ui32 k = 0; k < n; ++k) {
+        count += bands[k]->num_blocks.area();
+        bytes += bands[k]->num_blocks.area() * bands[k]->blocks[0].buf_bytes();
+      }
+      cb_unit* u = new cb_unit;
+      u->blocks = (codeblock*)malloc(count * sizeof(codeblock));
+      if (posix_memalign(&u->bufs, byte_alignment, bytes) != 0 || !u->blocks)
+        OJPH_ERROR(0x000300A2, "Cannot allocate a hand-off unit.");
+      u->live = n;
+      codeblock* cb = u->blocks;
+      ui8* buf = (ui8*)u->bufs;
+      for (ui32 k = 0; k < n; ++k) {
+        subband* b = bands[k];
+        b->unit = u;
+        b->grid = cb;
+        for (ui32 r = 0; r < b->num_blocks.h; ++r)
+          for (ui32 i = 0; i < b->num_blocks.w; ++i, ++cb) {
+            new (cb) codeblock(b->blocks[i]);
+            cb->set_buf(buf);
+            buf += cb->buf_bytes();
+            cb->recreate(b->cb_size_at(r, i),
+                         b->coded_cbs + i + r * b->num_blocks.w);
+          }
+      }
+      cb_pool::get().run(u->blocks, (ui32)count);
+    }
+#endif
