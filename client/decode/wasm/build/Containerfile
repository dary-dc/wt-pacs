ARG DEBIAN_IMAGE
FROM ${DEBIAN_IMAGE}
ARG DEBIAN_SNAPSHOT
RUN rm -f /etc/apt/sources.list.d/* \
 && echo "deb http://snapshot.debian.org/archive/debian/${DEBIAN_SNAPSHOT} bookworm main" > /etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && apt-get install -y --no-install-recommends python3=3.11.2-1+b1 python3-venv=3.11.2-1+b1 xz-utils=5.4.1-1+deb12u1 \
    make=4.3-4.1 patch=2.7.6-7 \
 && rm -rf /var/lib/apt/lists/*
