# Local tooling — never publish
.local/

# Rust / Python / Node
/target/
lab/other-clients/h3/target/

# Generated Quinn modules (crates.io 0.11.11 + patches/quinn-0.11.11-mtu-gso.patch).
/patched/quinn/src/**
!/patched/quinn/src/lib.rs
.venv/
node_modules/

# Dev TLS and transport endpoint (generate locally)
server/dev-cert/*.pem
client/dev-transport.json

# wasm-pack output (build with client/transport/wasm/build.sh)
client/transport/wasm/pkg/

# Generated TypeScript client bundles (build with client/transport/ts/build.sh)
client/transport/ts/dist/
# Shared client recorder tests (build via client/transport/ts/build.sh)
client/record/test/run.mjs
# transport-ts unit tests (build via client/transport/ts/build.sh)
client/transport/ts/test/run.mjs
# Contract suite bundles (build via client/transport/ts/build.sh)
client/contract/run.mjs
client/contract/dist/
# Telemetry cost bench bundle (build via client/transport/ts/build.sh)
lab/telemetry-cost/cost.mjs

# Generated fixtures by frame size (regenerate with lab/scripts/gen_tf_fixtures.sh)
lab/fixtures/frames_32k/*.sbnd
lab/fixtures/frames_250k/*.sbnd
lab/fixtures/frames_250k_live/*.sbnd
# Fixtures laid out by size (regenerate with NAME=... BYTES=... FRAMES=... gen_live_cell_fixture.sh)
lab/fixtures/frames_16k_rung/*.sbnd
lab/fixtures/frames_16k_big/*.sbnd
lab/fixtures/frames_250k_deep/*.sbnd
lab/fixtures/frames_16k_deep/*.sbnd
lab/fixtures/frames_16k_seq/*.sbnd
lab/fixtures/frames_250k_big/*.sbnd
lab/fixtures/frames_tiny/*.sbnd
lab/fixtures/frames_32k_big/*.sbnd
# AV1 tools, builds and streams (lab/av1)
lab/.av1-build/
# Generated decode fixtures (regenerate with lab/scripts/gen_htj2k_fixtures.sh)
lab/fixtures/decode_*/*.j2c
lab/fixtures/decode_*/*.sha256
# Decoded sample sets for the paint bench (regenerate with lab/paint-floor/frames.py)
lab/paint-floor/frames/
# The painter check's frames (regenerated by client/paint/check.mjs)
client/paint/frames/
# The synthetic metadata lab/page-open/enc.mjs writes and removes
lab/page-open/metadata.json
lab/page-open/meta-first.html
# The pages and the bundle lab/page-open/boot.mjs writes and removes
lab/page-open/boot/
# The client trees lab/page-open/coldrtt.mjs writes and removes
lab/page-open/.coldrtt/

# Python bytecode from lab analysis scripts
__pycache__/
*.pyc
# AV1 public series and their frames (fetch with lab/av1/fetch_data.sh)
lab/av1/data/
# AV1 tools built by lab/av1/tools/tools.sh, and the frames lab/av1/roundtrip.py makes
lab/.av1-work/
# Link traces a lab run fetches (lab/av1/delivery/total-time/run.mjs, lab/scripts/*_cells.sh)
lab/.traces/
lab/recv-cost/target/
