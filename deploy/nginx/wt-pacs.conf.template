# The static host for the viewer, answering as server/dev-server.py does in development: deploy/README.md.
# SERIES and TLS_LISTEN are substituted at container start.

# A re-packed catalog or an edited page must not be read stale from a heuristic cache;
# nginx's ETag and Last-Modified make each revalidation a 304.
map $sent_http_content_type $revalidate {
    ~^text/html         no-cache;
    ~^application/json  no-cache;
    default             "";
}

server {
    listen       8765;
    ${TLS_LISTEN}
    server_name  _;
    root         /srv/wt-pacs;
    autoindex    off;
    charset      utf-8;
    server_tokens off;

    # Cross-origin isolation. The page needs SharedArrayBuffer and a 5 us performance.now();
    # losing these degrades the client silently rather than failing, so `always`.
    add_header Cross-Origin-Opener-Policy   same-origin   always;
    add_header Cross-Origin-Embedder-Policy require-corp  always;
    add_header Cross-Origin-Resource-Policy same-origin   always;
    add_header Cache-Control                $revalidate   always;

    # mime.types says application/javascript for .js and has no .mjs; dev-server.py says text/javascript.
    include      /etc/nginx/mime.types;
    types {
        text/javascript  js mjs;
    }

    # A cold open fetches the page, its modules and two WASM binaries: compressed they are 2.9x smaller
    # (lab/page-open/README.md). Nothing is proxied, so gzip_proxied has nothing to do.
    gzip            on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary       on;
    gzip_types      text/css text/javascript application/javascript
                    application/json application/wasm image/svg+xml;

    # What the page loads, and nothing else: the page, its code, the series' metadata and the transport file.
    location = / { try_files /client/viewer/index.html =404; }
    location /client/ { try_files $uri =404; }
    location = /series/metadata {
        alias /studies/${SERIES}.metadata.json;
        default_type application/json;
    }
    location = /wt/dev-transport.json {
        alias /srv/wt-pacs/wt/dev-transport.json;
        default_type application/json;
    }
    location / { return 404; }
}
