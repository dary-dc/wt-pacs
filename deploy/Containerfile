# Two targets from one file: `web` serves the page, `server` speaks the transport.
# nginx cannot front the transport — it is QUIC on UDP and nginx has no QUIC upstream —
# so the browser dials the server directly, exactly as it does in development.
# A build with no --target stops at the last stage, `web`. deploy/README.md
#
# Every base is pinned by digest; REGISTRY may name a mirror serving the same digests.
ARG REGISTRY=docker.io/library

# ---------------------------------------------------------------- server
FROM ${REGISTRY}/rust:1.97-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS build
WORKDIR /src
# The workspace's members, each its manifest and sources alone: a doc or a lab result changes none of them.
COPY Cargo.toml Cargo.lock ./
COPY common ./common
COPY server ./server
COPY client/transport/wasm/Cargo.toml ./client/transport/wasm/Cargo.toml
COPY client/transport/wasm/src ./client/transport/wasm/src
COPY tools ./tools
COPY lab/disk-access-bench ./lab/disk-access-bench
COPY lab/window-harness ./lab/window-harness
COPY lab/telemetry-bench ./lab/telemetry-bench
COPY patched ./patched
COPY patches ./patches
COPY scripts/patch_crate.sh ./scripts/
# build_ca: the CA of a TLS-inspecting proxy between this host and the registries, empty where there is none.
RUN --mount=type=cache,target=/usr/local/cargo/registry --mount=type=cache,target=/src/target --mount=type=secret,id=build_ca \
    if [ -s /run/secrets/build_ca ]; then export CARGO_HTTP_CAINFO=/run/secrets/build_ca CURL_CA_BUNDLE=/run/secrets/build_ca SSL_CERT_FILE=/run/secrets/build_ca; fi && \
    cargo build --release --locked -p series-server && cp target/release/series-server /usr/local/bin/

# Same Debian release as `build`: the binary links glibc and a mismatch fails only at start.
FROM ${REGISTRY}/debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587 AS server
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
# Made here, owned by the server's user, so a fresh named volume mounted on them inherits both (and on web's).
RUN useradd -r -u 10001 wtpacs && install -d -o 10001 -g 10001 -m 0700 /certs && install -d -o 10001 -g 10001 -m 0755 /run/wt-pacs
COPY --from=build /usr/local/bin/series-server /usr/local/bin/series-server
COPY deploy/server-start.sh /usr/local/bin/server-start.sh
COPY fixtures/us_cine_smoke /studies
USER 10001
EXPOSE 4433/udp 4433/tcp
ENTRYPOINT ["/usr/local/bin/server-start.sh"]

# ---------------------------------------------------------------- client bundles
FROM ${REGISTRY}/node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS bundles
WORKDIR /src/client/transport/ts
COPY client/transport/ts/package.json client/transport/ts/package-lock.json ./
RUN --mount=type=secret,id=build_ca if [ -s /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi && \
    npm ci --no-audit --no-fund
WORKDIR /src
COPY client ./client
RUN client/transport/ts/build.sh --product

# ---------------------------------------------------------------- web
FROM ${REGISTRY}/nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de AS web
COPY deploy/nginx/wt-pacs.conf.template /etc/nginx/templates/
COPY deploy/nginx/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY client /srv/wt-pacs/client
COPY --from=bundles /src/client/transport/ts/dist /srv/wt-pacs/client/transport/ts/dist
COPY fixtures/us_cine_smoke /studies
# The decoders the page loads are built on the host from this tree (client/decode/wasm/build/build.sh) and must be
# the ones its manifest pins; the frame check's hasher is fetched by client/decode/wasm/fetch_xxh3.sh.
RUN cd /srv/wt-pacs/client/decode/wasm/built && sha256sum -c -s ../build/manifest.sha256 && \
    test -f ../vendor/hash-wasm/xxhash3.umd.min.js && install -d -o 10001 -g 10001 -m 0755 /srv/wt-pacs/wt && rm -f /etc/nginx/conf.d/default.conf
EXPOSE 8765 443
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
